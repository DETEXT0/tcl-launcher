<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_margin="4dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/manage_item_bg">

    <ImageView
        android:id="@+id/manageAppIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:contentDescription="Icono de app" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/manageAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de App"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/manageAppStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visible"
            android:textColor="#88FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/manageAppCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:buttonTint="#4CAF50" />

</LinearLayout>
