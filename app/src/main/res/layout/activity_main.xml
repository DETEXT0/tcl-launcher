<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fondo de pantalla -->
    <ImageView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Fondo de pantalla" />

    <!-- Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical">

        <!-- Reloj + Fecha al lado -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#88000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/dayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LUNES"
                    android:textColor="#EEFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:shadowColor="#88000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 DE ENERO"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:shadowColor="#88000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Clima -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#55000000"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/weatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️"
                    android:textSize="18sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/weatherText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C · --"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/weatherMinMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Máx: -- / Mín: --"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Widget música -->
        <LinearLayout
            android:id="@+id/musicWidget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#66000000"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/musicAlbumArt"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_media_play"
                android:layout_marginEnd="8dp"
                android:contentDescription="Album art" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/musicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="140dp" />

                <TextView
                    android:id="@+id/musicArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artista"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="140dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnPrev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:padding="4dp"
                android:focusable="true"
                android:contentDescription="Anterior" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_media_pause"
                android:tint="#FFFFFF"
                android:padding="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:focusable="true"
                android:contentDescription="Play/Pausa" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFF"
                android:padding="4dp"
                android:focusable="true"
                android:contentDescription="Siguiente" />
        </LinearLayout>

        <!-- Botones derecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnInputs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:padding="8dp"
                android:background="@drawable/circle_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/appsRecycler"
                android:layout_marginEnd="8dp"
                android:contentDescription="Entradas" />

            <ImageView
                android:id="@+id/btnWifi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_share"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:padding="8dp"
                android:background="@drawable/circle_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/appsRecycler"
                android:layout_marginEnd="8dp"
                android:contentDescription="WiFi" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:padding="8dp"
                android:background="@drawable/circle_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/appsRecycler"
                android:layout_marginEnd="8dp"
                android:contentDescription="Ajustes" />

            <ImageView
                android:id="@+id/btnManageApps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:padding="8dp"
                android:background="@drawable/circle_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/appsRecycler"
                android:layout_marginEnd="8dp"
                android:contentDescription="Gestionar apps" />

            <ImageView
                android:id="@+id/btnChangeWallpaper"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="#FFFFFF"
                android:alpha="0.8"
                android:padding="8dp"
                android:background="@drawable/circle_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/appsRecycler"
                android:contentDescription="Cambiar fondo" />

        </LinearLayout>

    </LinearLayout>

    <!-- BARRA INFERIOR: Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingTop="10dp"
        android:background="#66000000">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRecycler"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnSettings"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>

</FrameLayout>
